{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skykeep",
  "version": "0.1.14",
  "identifier": "io.github.yashwanthkamireddi.Skykeep",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Skykeep",
        "width": 1040,
        "height": 720,
        "minWidth": 480,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' quince: http://quince.localhost data: blob:; media-src 'self' quince: http://quince.localhost http://127.0.0.1:*; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' quince: http://quince.localhost data: blob:; media-src 'self' quince: http://quince.localhost http://127.0.0.1:*; connect-src ipc: http://ipc.localhost ws://localhost:* http://localhost:*; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": ["ics", "ical", "icalendar"],
        "name": "iCalendar",
        "description": "Calendar events",
        "mimeType": "text/calendar",
        "role": "Viewer"
      },
      {
        "ext": ["vcf", "vcard"],
        "name": "vCard",
        "description": "Contact card",
        "mimeType": "text/vcard",
        "role": "Viewer"
      }
    ],
    "shortDescription": "Your iCloud, on this computer",
    "longDescription": "Skykeep keeps your iCloud notes, reminders, calendar, contacts, Drive and photos on your own computer, so they open instantly and work offline. An independent project, not affiliated with or endorsed by Apple Inc. iCloud is a trademark of Apple Inc.",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/YashwanthKamireddi/Skykeep",
    "publisher": "Yashwanth Kamireddi",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "installerHooks": "../packaging/windows/installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["../packaging/windows/app-shortcuts.wxs"],
        "componentRefs": ["SkykeepAppShortcuts"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.39)",
          "libsecret-1-0",
          "libheif1 (>= 1.17)",
          "libheif-plugin-libde265",
          "libgstreamer1.0-0",
          "libgstreamer-plugins-base1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-libav"
        ],
        "desktopTemplate": "../packaging/io.github.yashwanthkamireddi.Skykeep.desktop.in",
        "files": {
          "/usr/share/metainfo/io.github.yashwanthkamireddi.Skykeep.metainfo.xml": "../packaging/io.github.yashwanthkamireddi.Skykeep.metainfo.xml",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Notes.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Notes.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Reminders.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Reminders.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Calendar.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Calendar.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Contacts.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Contacts.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Drive.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Drive.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Photos.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Photos.desktop",
          "/usr/share/gnome-shell/search-providers/io.github.yashwanthkamireddi.Skykeep.search-provider.ini": "../packaging/io.github.yashwanthkamireddi.Skykeep.search-provider.ini",
          "/usr/share/dbus-1/services/io.github.yashwanthkamireddi.Skykeep.SearchProvider.service": "../packaging/io.github.yashwanthkamireddi.Skykeep.SearchProvider.service",
          "/usr/share/krunner/dbusplugins/io.github.yashwanthkamireddi.Skykeep.krunner.desktop": "../packaging/io.github.yashwanthkamireddi.Skykeep.krunner.desktop",
          "/usr/share/icons/hicolor/16x16/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/16x16.png",
          "/usr/share/icons/hicolor/24x24/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/24x24.png",
          "/usr/share/icons/hicolor/32x32/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/icon.png"
        }
      },
      "rpm": {
        "depends": [
          "(glibc >= 2.39)",
          "libsecret-1.so.0()(64bit)",
          "libheif.so.1()(64bit)",
          "(libheif >= 1.17 or libheif1 >= 1.17)",
          "libgstreamer-1.0.so.0()(64bit)",
          "(gstreamer1-plugins-base or gstreamer-plugins-base)",
          "(gstreamer1-plugins-good or gstreamer-plugins-good)",
          "(gstreamer1-plugin-libav or gstreamer-plugins-libav)",
          "(gstreamer1-plugin-openh264 or gstreamer-plugin-openh264)"
        ],
        "desktopTemplate": "../packaging/io.github.yashwanthkamireddi.Skykeep.desktop.in",
        "files": {
          "/usr/share/metainfo/io.github.yashwanthkamireddi.Skykeep.metainfo.xml": "../packaging/io.github.yashwanthkamireddi.Skykeep.metainfo.xml",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Notes.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Notes.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Reminders.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Reminders.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Calendar.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Calendar.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Contacts.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Contacts.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Drive.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Drive.desktop",
          "/usr/share/applications/io.github.yashwanthkamireddi.Skykeep.Photos.desktop": "../packaging/apps/io.github.yashwanthkamireddi.Skykeep.Photos.desktop",
          "/usr/share/gnome-shell/search-providers/io.github.yashwanthkamireddi.Skykeep.search-provider.ini": "../packaging/io.github.yashwanthkamireddi.Skykeep.search-provider.ini",
          "/usr/share/dbus-1/services/io.github.yashwanthkamireddi.Skykeep.SearchProvider.service": "../packaging/io.github.yashwanthkamireddi.Skykeep.SearchProvider.service",
          "/usr/share/krunner/dbusplugins/io.github.yashwanthkamireddi.Skykeep.krunner.desktop": "../packaging/io.github.yashwanthkamireddi.Skykeep.krunner.desktop",
          "/usr/share/icons/hicolor/16x16/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/16x16.png",
          "/usr/share/icons/hicolor/24x24/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/24x24.png",
          "/usr/share/icons/hicolor/32x32/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/32x32.png",
          "/usr/share/icons/hicolor/48x48/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/48x48.png",
          "/usr/share/icons/hicolor/64x64/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/64x64.png",
          "/usr/share/icons/hicolor/128x128/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/128x128.png",
          "/usr/share/icons/hicolor/256x256/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/128x128@2x.png",
          "/usr/share/icons/hicolor/512x512/apps/io.github.yashwanthkamireddi.Skykeep.png": "icons/icon.png"
        }
      },
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib/libheif/plugins/libheif-libde265.so": "/usr/lib/x86_64-linux-gnu/libheif/plugins/libheif-libde265.so",
          "/usr/lib/libde265.so.0": "/usr/lib/x86_64-linux-gnu/libde265.so.0"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0NTY5QjZBMEYxODdFNzkKUldSNWZoZ1BhcHRXMUxlV3E1MXdFeGl1YmVTR3FTbEQ4a0RoUVRKaGxnRkM2TGgxTDlRZXpSWU0K",
      "endpoints": [
        "https://github.com/YashwanthKamireddi/Skykeep/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "skykeep"
}
